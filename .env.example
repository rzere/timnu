# Copy to .env.local and fill in. Never commit real keys.

# Required: your AI Ark API key (https://app.ai-ark.com/settings/api-management/dashboard).
# Free accounts get 100 credits/month.
AIARK_API_KEY=

# Optional: TypeSafe API key (https://console.typesafe.ai/keys), used to score lead fit with Jev.
# Without it, Timnu uses a free built-in heuristic score.
TYPESAFE_API_KEY=

# Optional: how many top-ranked leads each consult reveals (full name, LinkedIn, verified email).
# AI Ark charges 1 credit per email found, 0 when none is. Max 25. Default 10.
TIMNU_AUTO_REVEAL=10

# Optional: demo mode for a public hosted deployment running on a shared key.
# When TIMNU_DEMO=1, requests that use the server key are capped (see README).
# Visitors can still paste their own AI Ark key in the app to lift the caps.
TIMNU_DEMO=
TIMNU_DEMO_MAX_PAGES=2
TIMNU_DEMO_AUTO_REVEAL=5
TIMNU_DEMO_ALLOW_REVEAL=
TIMNU_DEMO_ALLOW_LOOKALIKES=
TIMNU_DEMO_REQUESTS_PER_HOUR=10
